# Gateway: yagona ichki kirish nuqtasi (konteyner :80 -> host 6788).
# TLS bu yerda emas: host nginx (certbot) 443 da tugatadi va 127.0.0.1:6788 ga uzatadi.
# Host: $http_host (port bilan). `$host` portni tashlaydi va nostandart portda (6788) WebSocket Origin tekshiruvi yiqiladi.
# Bu faylda faqat ${FRONTEND_UPSTREAM} almashtiriladi (NGINX_ENVSUBST_FILTER).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Host nginx yuborgan X-Forwarded-Proto ni saqlaymiz, bo'lmasa o'z sxemamiz
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# IP bo'yicha chastota cheklovi (ilova ichida ham Redis cheklovi bor: bu birinchi, arzon qatlam)
limit_req_zone $binary_remote_addr zone=api_zone:10m rate=60r/s;
limit_req_zone $binary_remote_addr zone=login_zone:10m rate=30r/m;
limit_req_status 429;
limit_conn_zone $binary_remote_addr zone=conn_zone:10m;

upstream api_upstream {
    server api:8000;
    keepalive 16;
}

upstream web_upstream {
    server ${FRONTEND_UPSTREAM};
}

server {
    listen 80;
    server_name _;

    client_max_body_size 50m;
    server_tokens off;

    # Docker tarmog'idan kelgan haqiqiy mijoz IP ni X-Forwarded-For dan olamiz
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    # Kamera (Face ID/skaner), geolokatsiya (davomat) va mikrofon (qo'ng'iroq) faqat o'z saytimiz uchun
    add_header Permissions-Policy "camera=(self), geolocation=(self), microphone=(self)" always;
    # CSP: faqat o'z manbamiz; rasm/ulanish uchun https: (xarita tile serveri mijozga qarab o'zgaradi), LiveKit ws(s)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ws: wss: https:; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # Sekin so'rovlardan (slowloris) himoya
    client_header_timeout 15s;
    client_body_timeout 60s;
    send_timeout 60s;
    large_client_header_buffers 4 16k;
    limit_conn conn_zone 100;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Prometheus metrikalari faqat ichki tarmoqdan (api:8000/api/metrics); tashqaridan yo'q
    location = /api/metrics {
        return 404;
    }

    location = /api/auth/login {
        limit_req zone=login_zone burst=10 nodelay;
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /api/ {
        limit_req zone=api_zone burst=200 nodelay;
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 120s;
    }

    location /ws/ {
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 3600s;
    }

    # LiveKit signalizatsiyasi (WebSocket). Media (7881/tcp, 7882/udp) nginx orqali o'tmaydi.
    location /livekit/ {
        proxy_pass http://livekit:7880/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://web_upstream;
        proxy_http_version 1.1;
        # Vite HMR (dev) websocket
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
}
