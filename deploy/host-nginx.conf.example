# Droplet (host) nginx: 443 da TLS (certbot), ilovaga 127.0.0.1:6788 orqali uzatadi.
# /etc/nginx/sites-available/client1.vaksinahr.uz  ->  sites-enabled ga symlink
#
#   certbot --nginx -d client1.vaksinahr.uz
#
# (certbot quyidagi 443 blokini va sertifikat yo'llarini o'zi to'ldiradi/yangilaydi)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name client1.vaksinahr.uz;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name client1.vaksinahr.uz;

    ssl_certificate     /etc/letsencrypt/live/client1.vaksinahr.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/client1.vaksinahr.uz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:6788;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
}
