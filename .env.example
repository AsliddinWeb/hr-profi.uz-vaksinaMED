# Mijoz: clients/<CLIENT_NAME>/ papkasi mavjud bo'lishi kerak
CLIENT_NAME=example
# Bir serverda bir nechta mijoz bo'lsa har biriga boshqa nom (docker loyiha nomi)
# COMPOSE_PROJECT_NAME=vaksinahr

# Gateway (yagona kirish nuqtasi). Productionda 127.0.0.1 (tashqaridan host nginx 443 orqali),
# lokal sinov uchun 0.0.0.0 qilish mumkin.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=6788

# `make init` quyidagi qiymatlarni tasodifiy yaratadi
ENV=production
SECRET_KEY=__generate__
POSTGRES_DB=vaksina
POSTGRES_USER=vaksina
POSTGRES_PASSWORD=__generate__
MINIO_ROOT_USER=vaksina
MINIO_ROOT_PASSWORD=__generate__

# Telegram bot (@BotFather dan token). Bo'sh bo'lsa Telegram o'chirilgan, tizim bunsiz ham ishlaydi.
TELEGRAM_BOT_TOKEN=
# Bildirishnomalardagi havolalar uchun: https://client1.vaksinahr.uz
PUBLIC_URL=

# Face ID (ixtiyoriy). Shablonlarni shifrlash kaliti: bo'sh bo'lsa SECRET_KEY dan olinadi. Prod da alohida qo'ying:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Kalit yo'qolsa yoki almashtirilsa mavjud shablonlar o'qilmaydi (xodimlar qayta ro'yxatdan o'tadi).
# FACE_ENCRYPTION_KEY=
# FACE_MATCH_THRESHOLD=0.40
# FACE_RETENTION_DAYS=365

# Qo'ng'iroq (LiveKit, F25). Kalit nomi ixtiyoriy, sir kamida 32 belgi (`make init` yaratadi).
# LIVEKIT_NODE_IP: lokalda 127.0.0.1, productionda serverning OCHIQ IP si.
LIVEKIT_API_KEY=vaksina
LIVEKIT_API_SECRET=__generate__
LIVEKIT_NODE_IP=127.0.0.1
# Bitta serverda bir nechta mijoz bo'lsa, har biriga boshqa portlar (standart 7881/7882)
# LIVEKIT_TCP_PORT=7881
# LIVEKIT_UDP_PORT=7882
# Bo'sh bo'lsa brauzer o'z domenidagi /livekit ga ulanadi. Alohida domen bo'lsa: wss://lk.example.uz
LIVEKIT_PUBLIC_URL=

# AI (F26): Claude API kaliti. Bo'sh bo'lsa AI o'chirilgan, tizim bunsiz ishlaydi. Model va limit: /ai/settings
ANTHROPIC_API_KEY=

# Zaxira (deploy/scripts/backup.sh). BACKUP_PASSPHRASE berilsa arxiv AES-256 bilan shifrlanadi (.enc).
# BACKUP_PASSPHRASE=
# Tashqi S3-mos saqlash (ixtiyoriy): arxiv shu yerga ham yuboriladi
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=vaksina-backups
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Kuzatuv (deploy/scripts/watchdog.sh): ogohlantirish yuboriladigan Telegram chat ID (TELEGRAM_BOT_TOKEN bilan)
# ALERT_TELEGRAM_CHAT_ID=
# Grafana (monitoring profili) paroli
# GRAFANA_PASSWORD=

# API worker jarayonlari soni (standart 3; ~CPU yadrolari soni, har biri ~150 MB xotira)
# WEB_CONCURRENCY=3
