{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HR-Profi client.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,30}$",
      "description": "Mijoz kaliti: papka nomi (clients/<name>) va CLIENT_NAME bilan bir xil"
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "tagline": {
          "type": "string",
          "maxLength": 120
        },
        "primary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "logo": {
          "type": [
            "string",
            "null"
          ],
          "description": "Logotip yo'li (frontend_ext/public ichida yoki to'liq URL)"
        }
      }
    },
    "plan": {
      "enum": [
        "premium",
        "pro",
        "start"
      ],
      "description": "KOSHI tarifi: modullar tarif bo'yicha yoqiladi. Berilmasa cheklov yo'q"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seats": {
          "type": "integer",
          "minimum": 1,
          "description": "Faol foydalanuvchilar soni chegarasi"
        },
        "valid_until": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Litsenziya amal qilish sanasi (YYYY-MM-DD)"
        },
        "holder": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ai": {
          "type": "boolean"
        },
        "answers": {
          "type": "boolean"
        },
        "attendance": {
          "type": "boolean"
        },
        "calls": {
          "type": "boolean"
        },
        "canteen": {
          "type": "boolean"
        },
        "checklists": {
          "type": "boolean"
        },
        "dashboard": {
          "type": "boolean"
        },
        "discipline": {
          "type": "boolean"
        },
        "employees": {
          "type": "boolean"
        },
        "face_id": {
          "type": "boolean"
        },
        "internship": {
          "type": "boolean"
        },
        "it_desk": {
          "type": "boolean"
        },
        "logistics": {
          "type": "boolean"
        },
        "migration": {
          "type": "boolean"
        },
        "mobile_tracking": {
          "type": "boolean"
        },
        "needs": {
          "type": "boolean"
        },
        "org": {
          "type": "boolean"
        },
        "payroll": {
          "type": "boolean"
        },
        "pharmacy": {
          "type": "boolean"
        },
        "reception": {
          "type": "boolean"
        },
        "recruit": {
          "type": "boolean"
        },
        "recruitment": {
          "type": "boolean"
        },
        "reminders": {
          "type": "boolean"
        },
        "reports": {
          "type": "boolean"
        },
        "tasks": {
          "type": "boolean"
        },
        "warehouse": {
          "type": "boolean"
        }
      }
    },
    "settings": {
      "type": "object",
      "description": "Core quyidagilarni o'qiydi; qolganini mijoz extension kodi ishlatadi",
      "properties": {
        "timezone": {
          "type": "string",
          "examples": [
            "Asia/Tashkent"
          ]
        },
        "map": {
          "type": "object",
          "properties": {
            "tiles": {
              "type": "string",
              "description": "{z}/{x}/{y} li URL shabloni"
            },
            "attribution": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
